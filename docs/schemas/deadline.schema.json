{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modulo.example/schemas/v1/deadline.schema.json",
  "title": "Deadline",
  "description": "An embedded task value, reconciled as one unit. Apply 23:59 before saving when input omits the time; validate the timezone/local-time/instant agreement in domain code.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01][0-9]|2[0-3]):[0-5][0-9]:00Z$"
    },
    "originalTimezone": {
      "$ref": "common.schema.json#/$defs/timezone"
    },
    "enteredDate": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "enteredTime": {
      "$ref": "common.schema.json#/$defs/localTime"
    }
  },
  "required": [
    "instant",
    "originalTimezone",
    "enteredDate",
    "enteredTime"
  ],
  "examples": [
    {
      "instant": "2026-11-17T15:59:00Z",
      "originalTimezone": "Asia/Singapore",
      "enteredDate": "2026-11-17",
      "enteredTime": "23:59"
    }
  ]
}
